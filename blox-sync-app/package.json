{
  "name": "blox-sync-app",
  "version": "2.2.0",
  "description": "Standalone Native Desktop Application and Sync Engine for Blox Sync",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "server-only": "node src/server/appServer.js",
    "build-exe": "electron-builder --win portable"
  },
  "keywords": [
    "blox-sync",
    "roblox",
    "vscode",
    "bridge",
    "luau",
    "rojo",
    "electron",
    "desktop-app",
    "knit"
  ],
  "author": "Esca-Byte",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "open": "^8.4.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.escabyte.bloxsyncapp",
    "productName": "BloxSyncApp",
    "artifactName": "${productName}.${ext}",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ]
  }
}